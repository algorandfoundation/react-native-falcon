{
  "name": "@algorandfoundation/react-native-falcon",
  "version": "0.0.0",
  "description": "Falcon is based on NTRU lattices, used with a hash-and-sign structure",
  "keywords": [
    "android",
    "falcon",
    "falcon-1024",
    "ios",
    "post-quantum",
    "react-native",
    "signature"
  ],
  "homepage": "https://github.com/algorandfoundation/react-native-falcon#readme",
  "bugs": {
    "url": "https://github.com/algorandfoundation/react-native-falcon/issues"
  },
  "license": "Apache-2.0",
  "author": "Algorand Foundation <apps@algorand.co> (https://algorand.co)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorandfoundation/react-native-falcon.git"
  },
  "workspaces": [
    "example"
  ],
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "falcon",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "example": "pnpm --filter react-native-falcon-example",
    "clean": "del-cli lib",
    "build": "bob build",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "jest",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@react-native/babel-preset": "0.83.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.5",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.12",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "jest": "^29.7.0",
    "lefthook": "^2.0.3",
    "nitrogen": "^0.35.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "^0.35.0",
    "semantic-release": "^25.0.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.35.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": false
        }
      ]
    ],
    "branches": [
      "release",
      {
        "name": "main",
        "prerelease": "canary",
        "channel": "next"
      }
    ]
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      ".pnpm/(?!(jest-)?react-native|@react-native|react-native-nitro-modules|@react-native/js-polyfills)"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "jest",
      "lefthook"
    ],
    "version": "0.57.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
